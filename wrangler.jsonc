{
  "name": "pixel-north-co-uk",
  "main": "worker/pixel-north-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": { "SITE": "pixel-north.co.uk", "CONSENT_RETENTION_MONTHS": "12" },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "CONSENT_DB",
      "database_name": "pixel-north-consent",
      "database_id": "9cd757f1-9ee8-4af3-b763-dc3417c2be8d"
    }
  ],
  "previews": {
    "ai": { "binding": "AI" },
    "vars": { "SITE": "pixel-north.co.uk" },
    "d1_databases": [
      {
        "binding": "CONSENT_DB",
        "database_name": "Staging",
        "database_id": "2743134e-ddbb-4e2b-86ac-b676a70b0295"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
