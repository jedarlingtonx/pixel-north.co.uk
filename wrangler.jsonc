{
  "name": "pixel-north-co-uk",
  "main": "worker/pixel-north-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "CONSENT_DB",
      "database_name": "pixel-north-consent",
      "database_id": "9cd757f1-9ee8-4af3-b763-dc3417c2be8d"
    }
  ],
  "previews": {
    "ai": { "binding": "AI" }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
